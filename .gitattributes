# Normalize all text files to LF in the repository.
# Without this, the Windows working tree writes CRLF, git stores LF, and every
# file shows as modified forever — which makes a real `git status` unreadable.
* text=auto eol=lf

# Windows-only scripts must keep CRLF on disk.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
