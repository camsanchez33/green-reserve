{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/parse-on-edit.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules ] && node scripts/codemap.mjs >/dev/null 2>&1; true"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
