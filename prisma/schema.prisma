generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (-pooler) endpoint — serverless-safe
  directUrl = env("DIRECT_URL") // direct endpoint — used for migrations only
}

model CourseOperator {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String
  emailVerified       Boolean   @default(false)
  verificationToken   String?
  resetToken          String?   @unique
  resetTokenExpiry    DateTime?
  onboardingStep      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorMethod     String    @default("email")
  twoFactorCode       String?
  twoFactorCodeExpiry DateTime?
  twoFactorAttempts   Int       @default(0)
  /// SD-5: bumped on a password change or reset — every outstanding operator
  /// token carries the version it was minted with and dies on mismatch.
  sessionVersion      Int       @default(0)
  phone               String    @default("")
  // MP-3: AdminUser has had this; CourseOperator never did, which is why
  // A-07's operator-last-login column renders "—" everywhere.
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  course              Course[]
}

model Course {
  id                         String                @id @default(cuid())
  /// TEST-1 (Cam 2026-10-22): a test course (e.g. "The GreenReserve Test Course").
  /// Only these can be reset from the admin, and they stay out of the
  /// platform's numbers, Problems and public lists (src/lib/real-courses.ts).
  isTest                     Boolean               @default(false)
  slug                       String                @unique
  name                       String
  type                       String                @default("public")
  city                       String                @default("")
  state                      String                @default("")
  zipCode                    String                @default("")
  address                    String                @default("")
  phone                      String                @default("")
  website                    String                @default("")
  bookingUrl                 String                @default("")
  holes                      Int                   @default(18)
  par                        Int                   @default(72)
  yardage                    Int                   @default(0)
  slope                      Int                   @default(0)
  courseRating               Float                 @default(0)
  description                String                @default("")
  amenities                  String[]
  walkingAllowed             String                @default("always")
  walkingNote                String                @default("")
  cartRequired               Boolean               @default(false)
  dresscode                  String[]
  minPlayers                 Int                   @default(1)
  maxPlayers                 Int                   @default(4)
  cancellationHours          Int                   @default(24)
  checkInWindowHours         Int                   @default(3)
  // MP-3 run B2b: Course money -> integer cents, renamed so a stale reader is
  // a compile error rather than a silent 100x. lateCancellationFee in
  // particular was DOLLARS while Booking.cancellationFeeTotal was CENTS —
  // the same fee in two units in one schema, which is what made a blanket
  // conversion dangerous. Both are cents now.
  // courseRating and rating below are NOT money and stay Float.
  lateCancellationFeeCents   Int                   @default(1000)
  /// SP-B (STAFF_POLICY_SPEC Part B): the course's cancellation & card policy.
  /// Card at booking is derived: required only when a late or no-show fee is set.
  lateFeeBasis               String                @default("booking") // "booking" | "player"
  lateFeeTiming              String                @default("hold_at_cutoff") // "hold_at_cutoff" | "late_cancel" | "late_cancel_or_no_show"
  noShowFeeCents             Int                   @default(0)
  noShowFeeBasis             String                @default("booking") // "booking" | "player"
  /// Minutes after the tee time with nobody checked in before a booking is marked a no-show automatically. Null = off.
  autoNoShowMinutes          Int?
  timezone                   String                @default("America/New_York")
  rainCheckPolicy            String                @default("")
  publicAdvanceDays          Int                   @default(7)
  memberAdvanceDays          Int                   @default(14)
  hasMemberPricing           Boolean               @default(false)
  hasResidentPricing         Boolean               @default(false)
  residentCounty             String                @default("")
  residentState              String                @default("")
  residentProofRequired      Boolean               @default(false)
  hasCaddies                 Boolean               @default(false)
  caddieType                 String                @default("")
  caddieLooperRateCents      Int                   @default(0)
  caddieForeRateCents        Int                   @default(0)
  caddieNote                 String                @default("")
  hasDrivingRange            Boolean               @default(false)
  drivingRangeType           String                @default("")
  rangeBallsFree             Boolean               @default(true)
  rangeBallsSmallPriceCents  Int                   @default(0)
  rangeBallsMediumPriceCents Int                   @default(0)
  rangeBallsLargePriceCents  Int                   @default(0)
  hasPuttingGreen            Boolean               @default(false)
  hasShortGameArea           Boolean               @default(false)
  hasProShop                 Boolean               @default(false)
  proShopPhone               String                @default("")
  restaurantType             String                @default("none")
  hasCartGirl                Boolean               @default(false)
  tournamentFrequency        String                @default("")
  hasLessons                 Boolean               @default(false)
  hasClubRental              Boolean               @default(false)
  clubRentalRateCents        Int                   @default(0)
  hasPushCartRental          Boolean               @default(false)
  pushCartRateCents          Int                   @default(0)
  hasBagStorage              Boolean               @default(false)
  hasLockerRoom              Boolean               @default(false)
  hasGpsCarts                Boolean               @default(false)
  hasTournaments             Boolean               @default(false)
  stripeAccountId            String                @default("")
  stripeAccountActive        Boolean               @default(false)
  /// W2-7 part B (Cam 2026-10-20): pro-shop sales tax through Stripe Tax on the
  /// course's own Stripe account. On only once its Stripe tax settings are
  /// active (head office + at least one state registration) — set in
  /// Settings → Pro shop → Sales tax by the owner.
  shopTaxOn                  Boolean               @default(false)
  rating                     Float                 @default(4.5)
  reviewCount                Int                   @default(0)
  imageGradient              String                @default("linear-gradient(160deg,#071810 0%,#1b4332 60%,#2d6a4f 100%)")
  brandColor                 String                @default("#24513B")
  establishedYear            Int?
  logoUrl                    String                @default("")
  heroImageUrl               String                @default("")
  /// PERS-1: optional short note from the course, shown on the golfer's
  /// confirmation page and in the confirmation email ("Check in at the pro shop").
  confirmationNote           String?
  featured                   Boolean               @default(false)
  active                     Boolean               @default(false)
  liveStatus                 String                @default("draft")
  // MP-3: welcomeEmailSentAt was doing double duty as "has this course ever
  // been live", which corrupts health states — a course taken offline looks
  // like one that never launched. These record the two facts separately.
  firstWentLiveAt            DateTime?
  offlineAt                  DateTime?
  welcomeEmailSentAt         DateTime?
  adminNotes                 String                @default("")
  archivedAt                 DateTime?
  archivedBy                 String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  operatorId                 String?
  operator                   CourseOperator?       @relation(fields: [operatorId], references: [id])
  conditions                 String                @default("")
  conditionsUpdatedAt        DateTime?
  giftCardUrl                String                @default("")
  heroPhotoUrl               String                @default("")
  teeTimes                   TeeTime[]
  bookings                   Booking[]
  schedules                  TeeTimeSchedule[]
  blackouts                  Blackout[]
  memberships                CourseMembership[]
  residents                  CourseResident[]
  /// GRP-1 (Cam 2026-10-19, after golfbergencounty.com): a course run alongside
  /// others (a county, a club with several courses). Groups are made in Admin
  /// only. A group has one golfer page listing its courses, and one resident
  /// list: a resident at any of its courses gets the resident rate at all of them.
  groupId                    String?
  group                      CourseGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  membershipTiers            MembershipTier[]
  staff                      CourseStaff[]
  teeSets                    TeeSet[]
  thread                     MessageThread?
  photos                     CoursePhoto[]
  teeTimeAlerts              TeeTimeAlert[]
  events                     CourseEvent[]
  nines                      Nine[]
  /// IC-1 / CS-1: when we next call the course; null = never scheduled.
  nextCheckInAt              DateTime?
  /// AW-4b: the last time anyone from the course (owner or staff) used the
  /// dashboard. Written at most every 15 minutes by resolveDashboardSession.
  staffLastSeenAt            DateTime?
  calls                      Call[]
  /// AG-1: the name the signer binds ("Hollow Creek Golf Club LLC") — NOT
  /// GreenReserve's entity name, which stays a placeholder per legal README.
  legalName                  String                @default("")
  agreements                 AgreementAcceptance[]
  courseProducts             CourseProduct[]
  monthlyReviews             MonthlyReview[]
  golferMessages             CourseMessage[]
  shopItems                  ShopItem[]
  shopSales                  ShopSale[]

  @@index([operatorId])
  @@index([groupId])
}

model CoursePhoto {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// A single tee box (Black/Blue/White/Red/Gold...) — courses with one set of
// markers just have one row here; courses with multiple tee options list them
// all so golfers/admin can see yardage/rating/slope per tee, not one flat number.
model TeeSet {
  id             String                @id @default(cuid())
  courseId       String
  course         Course                @relation(fields: [courseId], references: [id])
  name           String
  yardage        Int                   @default(0)
  rating         Float                 @default(0)
  slope          Int                   @default(0)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  nineYardages   TeeSetNine[]
  productRatings CourseProductTeeSet[]
}

// A named nine (North/South/West...) on a multi-nine course. Simple 18-hole
// courses never create these — Course's flat holes/par/yardage stay their
// display fallback (COURSE_LAYOUT_SPEC L1, no forced backfill).
model Nine {
  id             String       @id @default(cuid())
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name           String
  par            Int          @default(36)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  teeSetYardages TeeSetNine[]

  @@index([courseId])
}

// What a golfer actually books: an 18-hole course offers "18 holes" (+
// optionally "9 holes"); a 27-hole course offers each active combo of two
// nines as its own 18-hole product, plus optionally single nines. Slots
// (TeeTimeSchedule/TeeTime) get product scoping in COURSE_LAYOUT_SPEC L2 —
// this phase is the model + dashboard tab only.
model CourseProduct {
  id                String                @id @default(cuid())
  courseId          String
  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label             String
  holes             Int                   @default(18)
  nineIds           String[]
  active            Boolean               @default(true)
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())
  /// W2-6 slice 3: this round's own booking rules. Null = the course's rule
  /// (Course.walkingAllowed + cartRequired, minPlayers, maxPlayers,
  /// publicAdvanceDays). lib/booking-rules.ts merges them.
  walkingPolicy     String?
  minPlayers        Int?
  maxPlayers        Int?
  publicAdvanceDays Int?
  teeSetRatings     CourseProductTeeSet[]
  /// L2: schedules and generated slots scoped to this product.
  schedules         TeeTimeSchedule[]
  teeTimes          TeeTime[]

  @@index([courseId])
}

// Per-nine yardage for a given tee set (e.g. Blue tees, North nine = 3200y).
model TeeSetNine {
  id       String @id @default(cuid())
  teeSetId String
  teeSet   TeeSet @relation(fields: [teeSetId], references: [id], onDelete: Cascade)
  nineId   String
  nine     Nine   @relation(fields: [nineId], references: [id], onDelete: Cascade)
  yardage  Int    @default(0)

  @@unique([teeSetId, nineId])
}

// Rating/slope for a given tee set on a given product (a combo's rating for
// Blue tees differs from another combo's rating for the same Blue tees).
model CourseProductTeeSet {
  id              String        @id @default(cuid())
  courseProductId String
  courseProduct   CourseProduct @relation(fields: [courseProductId], references: [id], onDelete: Cascade)
  teeSetId        String
  teeSet          TeeSet        @relation(fields: [teeSetId], references: [id], onDelete: Cascade)
  rating          Float         @default(0)
  slope           Int           @default(0)

  @@unique([courseProductId, teeSetId])
}

model CourseStaff {
  id                  String    @id @default(cuid())
  courseId            String
  course              Course    @relation(fields: [courseId], references: [id])
  email               String    @unique
  password            String
  name                String
  role                String    @default("staff")
  /// SP-A (STAFF_POLICY_SPEC): what this staff login may do — keys from
  /// src/lib/staff-permissions.ts. Read only when permissionsSetAt is set.
  permissions         String[]  @default([])
  /// "starter" | "front_desk" | "manager" | "custom" — the preset last applied.
  preset              String    @default("")
  /// Null = never set by the owner: resolved as the Legacy preset in code, so
  /// staff created before SP-A keep their powers with no backfill.
  permissionsSetAt    DateTime?
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime  @default(now())
}

/// SP-A: who changed a staff member's permissions, append-only. No foreign
/// keys, so deleting a staff row never erases the record of what it could do.
model StaffPermissionChange {
  id        String   @id @default(cuid())
  courseId  String
  staffId   String
  changedBy String
  before    String[]
  after     String[]
  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
  @@index([staffId])
}

model GolferAccount {
  id                  String             @id @default(cuid())
  email               String             @unique
  password            String
  firstName           String
  lastName            String
  phone               String?            @unique // nullable + unique: Postgres treats each NULL as distinct, so this is "unique where set" without a partial index. Prep for GOLFER_SPEC G5 phone/OTP login — not wired up yet.
  stripeCustomerId    String             @default("")
  resetToken          String?            @unique
  resetTokenExpiry    DateTime?
  failedLoginAttempts Int                @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime           @default(now())
  bookings            Booking[]
  memberships         CourseMembership[]
}

model MembershipTier {
  id                   String             @id @default(cuid())
  courseId             String
  course               Course             @relation(fields: [courseId], references: [id])
  name                 String // "Full Member", "Junior", "Senior Associate"
  color                String             @default("#1b4332")
  // Pricing — flat rate overrides, INTEGER CENTS. null = fall back to
  // discountPct or the standard rate.
  //
  // MP-3 run B2a: these were dollars in a Float and are now cents in an Int.
  // The columns are RENAMED rather than just retyped, deliberately: Float and
  // Int are both `number` to TypeScript, so a silent missed conversion would
  // not fail to compile — it would just price something wrong by 100x. Renaming
  // makes every stale reader a compile error, which turns an unverifiable sweep
  // into an exhaustive one. It also disambiguates greenFeeWeekday, which exists
  // on BOTH this model and TeeTimeSchedule (still dollars, run B2d).
  // Convention matches Expense.amountCents, already in this schema.
  greenFeeWeekdayCents Int?
  greenFeeWeekendCents Int?
  cartFeeWeekdayCents  Int?
  cartFeeWeekendCents  Int?
  // Alternative: percentage off the standard rate (0–100). NOT money — stays a
  // Float and must never be scaled by 100.
  discountPct          Float?
  // Access privileges
  advanceBookingDays   Int                @default(14)
  guestPassesPerYear   Int                @default(0)
  // Informational
  annualFeeCents       Int                @default(0)
  initiationFeeCents   Int                @default(0) // one-time, charged with the first dues payment
  termMonths           Int                @default(12)
  notes                String             @default("")
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  memberships          CourseMembership[]
}

/// GRP-1: several courses run together (e.g. Bergen County's six). See Course.groupId.
model CourseGroup {
  id          String   @id @default(cuid())
  name        String
  /// The group's golfer page: /g/{slug}.
  slug        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

/// RES-1 (Cam 2026-10-19): a golfer who showed the pro shop their resident
/// card. A golfer signed in with this email books one player at the tee time's
/// resident rate; staff can set residents on any unpaid booking at the counter.
model CourseResident {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name       String
  /// Lower-cased; null = recognised only at the counter.
  email      String?
  cardNumber String   @default("")
  /// YYYY-MM-DD, last day the card is good; '' = no expiry.
  expiresOn  String   @default("")
  notes      String   @default("")
  addedBy    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([courseId, email])
  @@index([courseId])
}

model CourseMembership {
  id                  String          @id @default(cuid())
  golferId            String?
  golfer              GolferAccount?  @relation(fields: [golferId], references: [id])
  courseId            String
  course              Course          @relation(fields: [courseId], references: [id])
  tierId              String?
  tier                MembershipTier? @relation(fields: [tierId], references: [id])
  // Fallback name when no tier selected, or for non-golfer-account members
  membershipType      String          @default("member")
  // For members without a GolferAccount — invite flow
  inviteEmail         String          @default("")
  inviteName          String          @default("")
  invitePhone         String          @default("")
  inviteAccepted      Boolean         @default(false)
  status              String          @default("active")
  addedBy             String          @default("operator")
  expiresAt           DateTime?
  startedAt           DateTime?
  // Dues: unpaid | paid | paid_offline (cash/check at the shop) | comped
  paymentStatus       String          @default("unpaid")
  payToken            String          @default("")
  lastPaidAt          DateTime?
  lastPaymentIntentId String          @default("")
  renewalRemindedAt   DateTime?
  /// Members import (Cam 2026-10-19): an existing member brought over from the
  /// course's own list has already joined, so no dues payment adds the tier's
  /// one-time initiation fee and their history shows none.
  initiationWaived    Boolean         @default(false)
  notes               String          @default("")
  createdAt           DateTime        @default(now())

  @@unique([golferId, courseId])
  // MP-10 schema half: the overdue-dues surfaces filter by course + last payment.
  @@index([courseId, lastPaidAt])
}

model TeeTime {
  id                String         @id @default(cuid())
  courseId          String
  course            Course         @relation(fields: [courseId], references: [id])
  date              String
  time              String
  holes             Int            @default(18)
  playersAvailable  Int            @default(4)
  playersBooked     Int            @default(0)
  // MP-3 runs B2c+B2d: integer cents, renamed *Cents so a stale reader is a
  // compile error. TeeTime and TeeTimeSchedule convert in the SAME migration
  // because tee-sheet-engine copies schedule rates straight onto generated tee
  // times — converting one alone would need a x100 in the middle of that copy,
  // which is precisely the kind of stray multiplication this whole exercise is
  // meant to delete.
  greenFeeCents     Int
  memberRateCents   Int?
  residentRateCents Int?
  cartFeeCents      Int            @default(0)
  walkingAllowed    Boolean        @default(true)
  tierName          String         @default("standard")
  status            String         @default("available")
  createdAt         DateTime       @default(now())
  bookings          Booking[]
  teeTimeAlerts     TeeTimeAlert[]
  /// W2-9: the event holding this tee time (blocked for it); null = not an event's.
  /// Cancelling or moving the event releases only the times it holds.
  eventId           String?
  event             CourseEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// L2: the product this slot sells (null on simple courses). One row per
  /// product per time — two products may share a start time when their nines
  /// do not overlap.
  productId         String?
  product           CourseProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([courseId, date])
  @@index([eventId])
  // MP-3: the tee-sheet and generation paths filter on date alone across courses.
  @@index([date])
}

model Booking {
  id                         String            @id @default(cuid())
  teeTimeId                  String
  teeTime                    TeeTime           @relation(fields: [teeTimeId], references: [id])
  courseId                   String
  course                     Course            @relation(fields: [courseId], references: [id])
  golferAccountId            String?
  golferAccount              GolferAccount?    @relation(fields: [golferAccountId], references: [id])
  golferName                 String
  golferEmail                String
  golferPhone                String            @default("")
  players                    Int
  appliedRate                String            @default("standard")
  // MP-3 run B1: these six were ALREADY cents, stored in a Float — the worst of
  // both worlds, and the direct cause of the x100 resend-email bug (MP-1 #1),
  // where a caller assumed dollars. Now Int, so the unit is in the type. Every
  // stored value was already integral, so this migration changes no data and
  // needs no code changes: Prisma hands JS the same numbers as before.
  //
  // Dollar-denominated money elsewhere (TeeTime, TeeTimeSchedule, Course,
  // MembershipTier) is NOT converted here — that is a 64-file render sweep and
  // is its own run. Do not mix the two.
  greenFeeTotal              Int
  cartFeeTotal               Int               @default(0)
  cartSelected               Boolean           @default(false)
  rangeBallsSize             String            @default("")
  rangeBallsTotal            Int               @default(0)
  accessFeeTotal             Int
  totalAmount                Int
  // Card-on-file, deferred-payment flow — nothing is charged at booking time.
  stripeCustomerId           String            @default("")
  stripePaymentMethodId      String            @default("")
  stripePaymentIntentId      String            @default("")
  cancellationFeeTotal       Int               @default(0)
  cancellationFeeChargeId    String            @default("")
  cancellationFeeChargedAt   DateTime?
  cancelledAt                DateTime?
  // Check-in / round-charge flow (Phase 2) — direct charge on the course's
  // connected Stripe account, refunding the cancellation fee above if one was
  // already taken. checkInToken lets a golfer check in from the reminder
  // email on a fresh device without needing to be logged in.
  checkInToken               String?           @unique // generated explicitly in app code at booking creation, not a DB default —
  // existing rows added before this column existed will be null and just won't have a self-checkin link (staff can still check them in manually)
  checkedInAt                DateTime?
  roundPaymentIntentId       String            @default("")
  checkInFailReason          String            @default("")
  paymentStatus              String            @default("card_on_file")
  status                     String            @default("confirmed")
  // Booking terms consent — recorded at the moment of booking, never backfilled.
  termsAcceptedAt            DateTime?
  termsVersion               String?
  // MP-3: set at the cutoff crossing. Distinguishes "fee was owed and is
  // collectable" from "fee was stamped at booking but the golfer cancelled
  // free" — MP-1 #6 clears the amount on a free cancel, which fixed the
  // symptom; this records the state instead of inferring it from a zero.
  cancellationFeeApplies     Boolean           @default(false)
  /// SP-B: the course's policy copied at booking — a later policy change never reaches this booking.
  /// Null (bookings made before SP-B) behaves as "hold_at_cutoff", exactly as before.
  lateFeeTimingAtBooking     String?
  noShowFeeTotal             Int               @default(0)
  autoNoShowMinutesAtBooking Int?
  /// SD-5 lifecycle: 'online' | 'walk_in' | 'phone' — walk-ins and phone
  /// bookings are entered at the counter and pay there (paymentStatus 'manual').
  source                     String            @default("online")
  /// SD-5: how many of `players` actually showed (partial-party check-in); null = all
  checkedInPlayers           Int?
  /// SD-5: the counter marked the group a no-show (booking stays confirmed for the fee cron)
  noShowAt                   DateTime?
  /// SD-5: paid at the counter, not through Stripe — never counted as platform-collected
  paidOffline                Boolean           @default(false)
  /// SD-5: the course's cancellation window at the moment of booking, so a later policy change never moves this golfer's deadline
  cancellationHoursAtBooking Int?
  /// MP-6c schema half: when the round was actually paid (the charge
  /// succeeded, or the counter took it) — the Revenue window reads this,
  /// not checkedInAt, so a collect-then-check-in lands on the day the money moved.
  paidAt                     DateTime?
  /// POS-1a: pro-shop items added to the round (sum of BookingShopItem lines),
  /// charged WITH the round — never part of totalAmount, which stays the round's own price.
  shopTotalCents             Int               @default(0)
  /// POS-1a: GreenReserve's fee on those items — $0.50 per sale (once per booking
  /// with items, Cam 2026-10-08), paid by the golfer, taken as application fee.
  shopFeeCents               Int               @default(0)
  /// POS-1a (security review): set the moment a round charge is attempted —
  /// shop items cannot change after it, so the charge and the record agree.
  /// Cleared only when Stripe says, definitively, no money moved.
  shopLockedAt               DateTime?
  /// W2-7 B2: sales tax on those items (Stripe Tax on the course's account),
  /// charged with them. lib/round-shop-tax.ts keeps it current: the quote is for
  /// the lines in shopTaxKey and good until shopTaxExpiresAt; it is recorded for
  /// the course's tax reports (shopTaxTransactionId) once the round is paid.
  shopTaxCents               Int               @default(0)
  shopTaxCalculationId       String            @default("")
  shopTaxKey                 String            @default("")
  shopTaxExpiresAt           DateTime?
  shopTaxTransactionId       String            @default("")
  /// What the round's PaymentIntent actually took (round + shop items + fee).
  /// Refunds and receipts cap against this, never a recomputed figure.
  roundChargedCents          Int?
  /// RES-1 (Cam 2026-10-19): how many of `players` pay the resident rate, and
  /// the per-player resident rate used for them. The rest pay the booked
  /// standard (or member) rate; greenFeeTotal already includes both.
  residentPlayers            Int               @default(0)
  residentRateCents          Int?
  createdAt                  DateTime          @default(now())
  paymentEvents              PaymentEvent[]
  shopItems                  BookingShopItem[]

  // MP-3: Booking had ZERO indexes. Every admin money surface scans the table.
  @@index([courseId, createdAt])
  @@index([status, createdAt])
  @@index([teeTimeId])
  @@index([golferAccountId])
  // MP-10 schema half: the surfaces that filter by check-in / payment time.
  @@index([courseId, checkedInAt])
  @@index([courseId, paidAt])
}

model TeeTimeSchedule {
  id                       String         @id @default(cuid())
  courseId                 String
  course                   Course         @relation(fields: [courseId], references: [id])
  tierName                 String         @default("standard")
  daysOfWeek               Int[]
  startTime                String
  endTime                  String
  intervalMinutes          Int            @default(8)
  holes                    Int            @default(18)
  // MP-3 run B2d — integer cents. NOTE greenFeeWeekdayCents also exists on
  // MembershipTier (B2a); both are cents now, so mixing them is a semantic
  // error rather than a silent unit error.
  greenFeeWeekdayCents     Int
  greenFeeWeekendCents     Int
  memberRateWeekdayCents   Int?
  memberRateWeekendCents   Int?
  residentRateWeekdayCents Int?
  residentRateWeekendCents Int?
  cartFeeCents             Int            @default(0)
  walkingAllowed           Boolean        @default(true)
  active                   Boolean        @default(true)
  createdAt                DateTime       @default(now())
  /// L2: which bookable product this schedule generates slots for. Null = the
  /// simple case (one product, the course as a whole) — unchanged behaviour.
  productId                String?
  product                  CourseProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model Blackout {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  date     String
  reason   String @default("")
}

model TeeTimeAlert {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  email       String
  name        String    @default("")
  date        String // YYYY-MM-DD
  windowStart String    @default("") // HH:MM, empty = any time
  windowEnd   String    @default("") // HH:MM, empty = any time
  players     Int       @default(1)
  teeTimeId   String? // null = criteria alert; set = full-slot alert
  teeTime     TeeTime?  @relation(fields: [teeTimeId], references: [id], onDelete: SetNull)
  token       String    @unique @default(cuid())
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([courseId, date])
}

model CourseInquiry {
  id                   String               @id @default(cuid())
  firstName            String               @default("")
  lastName             String               @default("")
  contactName          String
  contactTitle         String
  email                String
  phone                String
  courseName           String
  address              String
  city                 String
  state                String
  zipCode              String
  website              String               @default("")
  courseType           String
  currentBookingMethod String               @default("")
  teeTimesPerDay       Int?
  greenFeeRange        String               @default("")
  hasResidentPricing   Boolean              @default(false)
  hasMemberPricing     Boolean              @default(false)
  hasCaddies           Boolean              @default(false)
  pricingNotes         String               @default("")
  facilitiesNotes      String               @default("")
  lookingFor           String[]
  additionalNotes      String               @default("")
  needsJson            String               @default("")
  status               String               @default("pending")
  adminNotes           String               @default("")
  builtCourseId        String?
  detailsToken         String?              @unique
  detailsJson          String               @default("")
  reviewStartedAt      DateTime?
  wentLiveAt           DateTime?
  // MP-3 growth columns. Cheap now, unanswerable later:
  //   source        — which channel converts. THE pre-launch question, and
  //                   nothing in the schema can answer it today.
  //   closedReason  — "why do we lose leads" is currently unanswerable because
  //                   Reject captures no reason.
  //   snoozeUntil   — "the GM said call after Labor Day" currently either nags
  //                   forever or gets archived and forgotten.
  //   nextFollowUpAt— the queue-first pipeline in MP-4 sorts on it.
  source               String?
  closedReason         String?
  snoozeUntil          DateTime?
  nextFollowUpAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  events               InquiryStatusEvent[]
  changeRequests       ChangeRequest[]
  /// IC-1 (A1): build without a call, with a reason on record.
  callSkippedReason    String?
  calls                Call[]
  /// SC-1: token for the public "pick a call time" page. Same pattern as
  /// detailsToken — unique, generated in app code, regenerated on resend.
  callInviteToken      String?              @unique
  callInviteSentAt     DateTime?
  callInviteExpiresAt  DateTime?

  // MP-3: the orphan sweep and every lifecycle pairing filter on this.
  @@index([builtCourseId])
}

/// IC-1: one calls table for the whole relationship — discovery calls while it
/// is an inquiry, check-in calls once it is a course. Exactly one of
/// inquiryId / courseId is set (enforced in the API, not the DB).
/// COURSES_SHEET_SPEC CS-1 reads the same rows — do NOT add a second model.
model Call {
  id             String         @id @default(cuid())
  /// 'discovery' (inquiry) | 'checkin' (course)
  kind           String
  inquiryId      String?
  inquiry        CourseInquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  durationMin    Int            @default(30)
  /// 'we_call' | 'they_call'
  direction      String         @default("we_call")
  phone          String         @default("")
  /// JSON string: string[] of agenda item keys checked for this call
  agendaJson     String         @default("[]")
  /// free text the admin adds for this course ("Tuesday league")
  agendaExtra    String         @default("")
  /// 'scheduled' | 'talked' | 'no_answer' | 'not_a_fit' | 'cancelled'
  outcome        String         @default("scheduled")
  /// JSON string: Record<agendaKey, string> — what was said, per item
  answersJson    String         @default("{}")
  notes          String         @default("")
  followUpAt     DateTime?
  completedAt    DateTime?
  createdBy      String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  /// SC-2: set when the COURSE booked this slot itself, rather than an admin
  /// scheduling it. Distinguishes "they chose this" from "we told them".
  bookedByCourse Boolean        @default(false)
  /// Google Calendar event id, so reschedule/cancel can move or delete it.
  /// Null when the calendar write failed — the call still stands.
  gcalEventId    String?

  @@index([inquiryId, scheduledAt])
  @@index([courseId, scheduledAt])
}

model InquiryStatusEvent {
  id         String        @id @default(cuid())
  inquiryId  String
  fromStatus String
  toStatus   String
  trigger    String // 'system' | 'admin'
  actorName  String?
  createdAt  DateTime      @default(now())
  inquiry    CourseInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  // MP-3: read on every inquiry detail load and by the stage-entry-time
  // derivations MP-4 needs.
  @@index([inquiryId])
}

// Per-IP fixed-window rate limiting (shared across serverless instances)
model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

model AdminUser {
  id                     String          @id @default(cuid())
  email                  String          @unique
  name                   String
  passwordHash           String
  role                   String          @default("manager") // "owner" | "manager" | "support" | "viewer"
  active                 Boolean         @default(true)
  mustChangePassword     Boolean         @default(false)
  lastLoginAt            DateTime?
  createdAt              DateTime        @default(now())
  setPasswordToken       String?         @unique
  setPasswordTokenExpiry DateTime?
  twoFactorCode          String?
  twoFactorCodeExpiry    DateTime?
  twoFactorAttempts      Int             @default(0)
  /// OWNER TOTP 2FA: base32 secret for the authenticator app; null = not
  /// enrolled, the email-code path stays in force (lockout safety).
  twoFactorSecret        String?
  twoFactorEnrolledAt    DateTime?
  /// bcrypt hashes of the ten single-use recovery codes; a used one is removed
  twoFactorRecoveryCodes String[]        @default([])
  failedLoginAttempts    Int             @default(0)
  lockoutUntil           DateTime?
  // MP-3. NOTE: the spec justified this as the fix for "deactivating an admin
  // doesn't end their session". MP-2 already fixed that with a per-request
  // `active` check and MP-2d extended it to re-read `role`, so demotion and
  // deactivation both take effect immediately without this. It also cannot
  // save the query — you would read the row to get the version. What remains
  // is a deliberate "sign out everywhere" lever: bump it to invalidate every
  // outstanding token for this admin at once. Added while migrations are cheap.
  sessionVersion         Int             @default(0)
  /// AW-11 (Cam 2026-10-22, "per-person access"): the admin areas this employee
  /// can open (lib/admin-areas.ts), set by the owner on Team. areasSetAt null =
  /// never set: every area their role reaches. Ignored for the owner.
  areas                  String[]        @default([])
  areasSetAt             DateTime?
  auditLogs              AdminAuditLog[]
  /// AW-1 (Cam 2026-10-20: "My owner sign in should be /cam and should be
  /// unbelievably secure"): the owner's sign-ins and trusted devices.
  ownerSessions          OwnerSession[]
  ownerDevices           OwnerDevice[]
  /// AW-1b: the owner's passkeys, and the one WebAuthn challenge in flight
  /// (sign-in at /cam, or adding a passkey), good until passkeyChallengeExpiry.
  ownerPasskeys          OwnerPasskey[]
  passkeyChallenge       String?
  passkeyChallengeExpiry DateTime?
}

/// AW-1b (Cam 2026-10-21: "Passkey" as the owner's second factor): a passkey
/// (Face ID / Touch ID / security key). Only its public key is stored.
model OwnerPasskey {
  id           String    @id @default(cuid())
  adminId      String
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// base64url credential id, as WebAuthn reports it
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  name         String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([adminId])
}

/// AW-1: one owner sign-in at /cam. The gr_owner cookie names this row; a
/// session is good only while it is neither revoked nor expired (4 hours), so
/// "sign out everywhere" and a stolen cookie both end at the database.
model OwnerSession {
  id         String       @id @default(cuid())
  adminId    String
  admin      AdminUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     OwnerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// How the second factor was proved: 'passkey' | 'totp' | 'recovery' | 'email'.
  method     String
  ip         String       @default("")
  userAgent  String       @default("")
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime     @default(now())
  revokedAt  DateTime?
  /// AW-1c: when this session last proved a second factor (sign-in, or a
  /// "confirm it's you"). Risky actions need it within the last 5 minutes.
  stepUpAt   DateTime?

  @@index([adminId])
}

/// AW-1: a device the owner has approved from an emailed link. The browser
/// keeps a random token (gr_owner_device cookie); only its SHA-256 is stored.
/// A device is trusted once approvedAt is set and until revokedAt.
model OwnerDevice {
  id                String         @id @default(cuid())
  adminId           String
  admin             AdminUser      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash         String         @unique
  label             String         @default("")
  ip                String         @default("")
  approvalTokenHash String?        @unique
  approvalExpiresAt DateTime?
  approvedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime       @default(now())
  lastUsedAt        DateTime?
  sessions          OwnerSession[]

  @@index([adminId])
}

model Announcement {
  id         String                  @id @default(cuid())
  title      String
  body       String
  emailSent  Boolean                 @default(false)
  sentById   String
  createdAt  DateTime                @default(now())
  dismissals AnnouncementDismissal[]
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  operatorId     String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, operatorId])
}

model MessageThread {
  id                  String    @id @default(cuid())
  courseId            String    @unique
  adminLastEmailAt    DateTime?
  operatorLastEmailAt DateTime?
  /// MP-7b: an admin closed the conversation (it's finished). Any new message
  /// from either side clears it. Null = open.
  closedAt            DateTime?
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages            Message[]
}

model Message {
  id          String        @id @default(cuid())
  threadId    String
  senderType  String // "admin" | "operator"
  senderId    String
  senderName  String
  body        String
  readAt      DateTime?
  isBroadcast Boolean       @default(false)
  createdAt   DateTime      @default(now())
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// GreenReserve's own fixed operating costs (Vercel, Neon, Resend, Twilio,
// domain, legal, etc.), entered by an owner on /admin/revenue to turn the
// fees-earned view into a real P&L (RUN_QUEUE "EXPENSE TRACKER / real P&L").
// Automatic Stripe processing costs are NOT stored here — those are pulled
// live from Stripe balance transactions. Monthly/annual costs are prorated
// into whatever period the revenue page is showing; endedAt lets a cost
// stop counting without deleting its history.
/// AW-4b (Cam 2026-10-21): the owner's goals on Admin → Goals. metric:
/// 'courses_live' (counted now) | 'online_rounds' | 'fees' (counted from
/// startsAt to dueAt; fees target in cents).
model AdminGoal {
  id        String   @id @default(cuid())
  metric    String
  target    Int
  startsAt  DateTime @default(now())
  dueAt     DateTime
  createdBy String   @default("")
  createdAt DateTime @default(now())

  @@index([dueAt])
}

/// BRAIN-1b (Cam 2026-10-22): every email and text GreenReserve sends, one row
/// each — what kind, to whom, about which course/booking/inquiry, and whether
/// the provider took it. Never the subject or body (some carry sign-in codes).
/// Written by the one email choke point (lib/email.ts getResend) and
/// lib/twilio.ts; read by the course timeline.
model SentMessage {
  id         String   @id @default(cuid())
  channel    String   // "email" | "sms"
  kind       String
  to         String
  courseId   String?
  bookingId  String?
  inquiryId  String?
  status     String   // "sent" | "failed"
  providerId String   @default("")
  error      String   @default("")
  createdAt  DateTime @default(now())

  @@index([courseId, createdAt])
  @@index([to, createdAt])
  @@index([bookingId])
  @@index([inquiryId])
  @@index([createdAt])
}

/// BRAIN-2a: a problem's history — opened, cleared, reopened (the hourly check),
/// claimed, assigned, noted, snoozed (people). Append-only.
model AdminAlertEvent {
  id        String     @id @default(cuid())
  alertId   String
  alert     AdminAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  kind      String
  actorName String     @default("")
  text      String     @default("")
  createdAt DateTime   @default(now())

  @@index([alertId, createdAt])
}

model Expense {
  id          String    @id @default(cuid())
  name        String
  category    String    @default("other") // "infra" | "tools" | "legal" | "other"
  amountCents Int
  cadence     String    @default("monthly") // "monthly" | "annual" | "one-time"
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// MP-3 — the three tables §5 asks for. Storage only in this run; the code that
// writes to them ships with the features that need them (MP-6 money, MP-4
// pipeline, MP-8 system). Tables are what is expensive to add at scale — the
// writers are not.
// ─────────────────────────────────────────────────────────────────────────────

/// Every movement of money against a booking, as an append-only ledger.
/// Today the P&L is reconstructed by reading Booking columns and inferring what
/// must have happened — refunds in particular already occur and already fail
/// invisibly. `kind` is one of:
///   fee_collected · cancel_fee_charged · cancel_fee_refunded · refund · dispute
/// amountCents is ALWAYS integer cents, independent of the Float→cents
/// conversion in run B — new money data starts correct.
model PaymentEvent {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind        String
  amountCents Int
  /// Stripe PaymentIntent / Refund id, when the event corresponds to one.
  stripeId    String   @default("")
  /// Who or what caused it: 'cron' | 'admin' | 'operator' | 'golfer' | 'stripe'
  actor       String   @default("system")
  actorName   String?
  /// Free-text detail — a decline reason, a dispute code, a note.
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([bookingId])
  @@index([kind, createdAt])
  @@index([createdAt])
}

/// EV-1: what happened to a booking, one row per real-world occurrence, kept
/// forever. APPEND-ONLY — no code path updates or deletes a row; a correction is
/// a new row (that is why no_show_cleared exists). courseId, amountCents,
/// playerCount and teeTimeAt are copied, not joined, and bookingId has NO
/// foreign key, so a price change or a deleted booking/course cannot rewrite or
/// cascade away history. PaymentEvent stays the money-ops ledger; this is the
/// analytics log. Written through src/lib/booking-events.ts only.
enum BookingEventType {
  booking_created
  booking_cancelled
  checked_in
  no_show_marked
  no_show_cleared
  fee_charged
  fee_refunded
  /// ACT-1: a group moved to another tee time (metadata: from/to, by whom).
  booking_moved
  /// RES-1: staff changed a group's price at the counter (residents in the group; metadata: before/after).
  price_changed
}

enum EventActorType {
  golfer
  staff
  admin
  cron
  system
}

model BookingEvent {
  id          String           @id @default(cuid())
  bookingId   String
  courseId    String
  type        BookingEventType
  occurredAt  DateTime         @default(now())
  actorType   EventActorType
  actorId     String?
  amountCents Int?
  playerCount Int?
  teeTimeAt   DateTime?
  /// PaymentIntent / Refund id for Stripe-backed events — @unique makes a cron
  /// retry or a double submit a no-op.
  stripeId    String?          @unique
  metadata    Json?

  @@index([courseId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([type, occurredAt])
}

/// The course-approval / change-request loop, currently encoded as JSON stuffed
/// into InquiryStatusEvent.actorName. One reworded log line breaks it today.
model ChangeRequest {
  id          String        @id @default(cuid())
  inquiryId   String
  inquiry     CourseInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// Which part of the page the course wants changed.
  category    String
  body        String        @default("")
  /// 'open' | 'addressed' | 'dismissed'
  status      String        @default("open")
  raisedBy    String        @default("course")
  addressedBy String?
  addressedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([inquiryId])
  @@index([status, createdAt])
}

/// Heartbeat for the crons. They charge cards on a schedule with no record that
/// they ran, so a silently dead cron is invisible until someone notices money
/// stopped moving. The System page turns red off this.
model CronRunLog {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// 'ok' | 'error'
  outcome    String    @default("ok")
  /// Whatever the job wants to record — counts, ids, a decline summary.
  detail     String    @default("")
  error      String    @default("")

  @@index([job, startedAt])
  @@index([startedAt])
}

/// Admin audit trail. Cannot be backfilled, so the column has to exist before
/// the first action worth auditing.
model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  /// What was acted on: 'course' | 'inquiry' | 'booking' | 'admin' | ...
  targetType String    @default("")
  targetId   String    @default("")
  detail     String    @default("")
  /// BRAIN-1a: why — required on money, access and delete actions (REASON_ACTIONS in lib/admin-audit.ts).
  reason     String    @default("")
  /// BRAIN-1a: the fields changed, as they were and as they became (only what the action touched).
  before     Json?
  after      Json?
  /// BRAIN-1a: the course this touched, when it touched one — the course timeline reads it.
  courseId   String?
  /// BRAIN-1a: the admin's name at the time, so the record reads the same after a rename.
  actorName  String    @default("")
  createdAt  DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
  @@index([courseId, createdAt])
  @@index([action, createdAt])
}

/// AG-1: one row per acceptance of one document version by one course. Never
/// updated after insert, never deleted — a course that leaves keeps its history.
model AgreementAcceptance {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// 'operator_agreement' | 'brand_license' | 'accuracy_attestation'
  document          String
  version           String
  /// sha256 of the exact Markdown file rendered to the signer (lib/agreements.ts)
  textHash          String
  signerName        String
  signerTitle       String
  signerEmail       String
  /// "I am authorized to enter into this agreement on behalf of <course name>"
  authorityAttested Boolean  @default(false)
  /// brand_license only: marketing use opt-out
  marketingOptOut   Boolean  @default(false)
  ip                String   @default("")
  userAgent         String   @default("")
  /// URL of the stored PDF (Vercel Blob); set after render, may lag by seconds
  pdfUrl            String?
  /// migrated from the old timeline line — no signer, no hash
  legacy            Boolean  @default(false)
  acceptedAt        DateTime @default(now())

  /// Security review: two simultaneous signings can never produce two rows for one act.
  @@unique([courseId, document, version])
  @@index([courseId, document, acceptedAt])
}

/// AG-1: which version of each document is current, and since when. One row
/// per (document, version). The re-acceptance clock reads `effectiveAt`.
model AgreementVersion {
  id           String    @id @default(cuid())
  document     String
  version      String
  textHash     String
  effectiveAt  DateTime
  /// 30-day re-accept deadline for courses on an older version; null = no
  /// re-acceptance required for this bump (attorney-blessed minor edit)
  reacceptBy   DateTime?
  noticeSentAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([document, version])
}

/// BI-1 (PLATFORM_ROADMAP_SPEC §1, Cam 2026-10-07): the monthly AI review of a
/// course's previous month. `metrics` holds the numbers computed by
/// lib/analytics.ts — the ONLY numbers the written text may use. The first full
/// month a course is live is its baseline; later reviews measure against it.
model MonthlyReview {
  id         String    @id @default(cuid())
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// YYYY-MM, in the course's own timezone.
  month      String
  isBaseline Boolean   @default(false)
  metrics    Json
  /// written | thin | failed
  status     String
  body       String?
  model      String?
  error      String?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([courseId, month])
  @@index([courseId])
}

/// MSG-1 (PLATFORM_ROADMAP_SPEC §5): a notice a course sent to the golfers
/// booked on one day (or a window of it) — "frost delay, first tee 9:00".
/// Operational only: it goes to people booked that day, never a marketing list.
model CourseMessage {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD, course-local
  date      String
  /// HH:MM window, inclusive; null = the whole day
  fromTime  String?
  toTime    String?
  body      String
  sentEmail Int      @default(0)
  sentSms   Int      @default(0)
  failed    Int      @default(0)
  /// "staff:<id>" / "op:<id>"
  sentBy    String
  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
}

/// POS-1a (PLATFORM_ROADMAP_SPEC §4): a course's pro-shop catalog — apparel,
/// balls, range buckets, rentals. POS-2 (Cam 2026-10-19): optional stock count.
model ShopItem {
  id          String            @id @default(cuid())
  courseId    String
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  category    String            @default("")
  priceCents  Int
  /// Hidden from "Add to round" but kept, so past sales still name it.
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  /// POS-2: how many are on the shelf; null = not counted. Paid walk-up sales
  /// and items added to a round take from it. Never blocks a sale.
  stockCount  Int?
  /// W2-7: the item's own code — SKU or barcode number (searchable; scanning later).
  sku         String            @default("")
  /// W2-7 (Cam 2026-10-20): sizes/colors are OPTIONS of one item. An option is
  /// its own sellable row (own price, stock, SKU) under its parent; its name is
  /// "<parent> — <optionLabel>" so every sale line reads right. A parent with
  /// options is not sold itself — staff pick an option.
  parentId    String?
  parent      ShopItem?         @relation("ShopItemOptions", fields: [parentId], references: [id], onDelete: Cascade)
  options     ShopItem[]        @relation("ShopItemOptions")
  optionLabel String            @default("")
  /// W2-7 part B: how the item is taxed — a key of TAX_CATEGORIES in lib/sales-tax.ts (Stripe product tax code).
  taxCategory String            @default("general")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sales       BookingShopItem[]
  saleLines   ShopSaleLine[]

  @@index([courseId])
  @@index([parentId])
}

/// POS-2 (Cam 2026-10-19): a walk-up pro-shop sale with no round attached —
/// paid in cash at the counter, or by a pay link the customer opens on their
/// phone (a direct charge on the course's Stripe account, like a round).
model ShopSale {
  id               String         @id @default(cuid())
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// open (pay link sent, not paid) | paid_cash | paid_card | void
  status           String         @default("open")
  /// What the customer pays: the lines plus taxCents.
  totalCents       Int
  /// W2-7 part B: sales tax on this sale (Stripe Tax), its calculation, and the
  /// tax transaction recorded on the course's account once paid ("" = not yet).
  taxCents         Int            @default(0)
  taxCalculationId String         @default("")
  taxTransactionId String         @default("")
  customerName     String         @default("")
  customerPhone    String         @default("")
  customerEmail    String         @default("")
  /// The pay link's secret (open sales only); '' for cash.
  payToken         String         @default("")
  paymentIntentId  String         @default("")
  /// Set while a card charge is in flight (status 'paying'); a void waits for it.
  chargeStartedAt  DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  /// Who rang it up (staff/owner email).
  soldBy           String         @default("")
  createdAt        DateTime       @default(now())
  lines            ShopSaleLine[]

  @@index([courseId, createdAt])
}

/// POS-2: one line of a walk-up sale. Name and price are copied when it is
/// rung up, so a catalog edit never changes a receipt.
model ShopSaleLine {
  id             String    @id @default(cuid())
  saleId         String
  sale           ShopSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  shopItemId     String?
  shopItem       ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  quantity       Int       @default(1)

  @@index([saleId])
  @@index([shopItemId])
}

/// POS-1a: one line of shop items added to a booking. Name and price are copied
/// at the moment it is added, so a later catalog edit never changes what a
/// golfer was charged.
model BookingShopItem {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  shopItemId     String?
  shopItem       ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  name           String
  unitPriceCents Int
  quantity       Int       @default(1)
  /// W2-7 B2: how it is taxed (TAX_CATEGORIES key), copied from the item when added.
  taxCategory    String    @default("general")
  /// Who added it (staff/owner email).
  addedBy        String    @default("")
  createdAt      DateTime  @default(now())

  @@index([bookingId])
  @@index([shopItemId])
}

/// AW-5 (Cam 2026-10-21): the admin's own alerts. One row per problem the
/// hourly check has seen (key = what it is, e.g. "cron:hourly", "nostripe:<course>"),
/// so each is emailed once when it starts and marked resolved when it clears;
/// and one row per morning digest ("digest:YYYY-MM-DD"), so it goes out once.
model AdminAlert {
  id          String    @id @default(cuid())
  key         String    @unique
  kind        String // "urgent" | "digest"
  title       String    @default("")
  detail      String    @default("")
  href        String    @default("")
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  alertedAt   DateTime?
  resolvedAt  DateTime?
  /// BRAIN-2a (Cam 2026-10-22): the Problems page. Who is on it, the course it is
  /// about (when it is about one), and a snooze — never a manual "resolved": a
  /// problem clears only when the hourly check stops seeing it.
  ownerId      String?
  ownerName    String    @default("")
  courseId     String?
  snoozedUntil DateTime?
  snoozeReason String    @default("")
  events       AdminAlertEvent[]

  @@index([kind, resolvedAt])
  @@index([courseId])
}

/// W2-9 Events (Cam 2026-10-21/22): an outing, tournament, league night or
/// other group event. Saving it holds its tee times (blocked, TeeTime.eventId)
/// and builds its prep checklist. Payments come in a later slice.
model CourseEvent {
  id                  String              @id @default(cuid())
  courseId            String
  course              Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name                String
  /// outing | tournament | league | other
  kind                String              @default("outing")
  date                String // YYYY-MM-DD, the course's calendar day
  /// shotgun | tee_times
  format              String              @default("shotgun")
  /// Shotgun: when it starts. Tee times: the first tee time.
  startTime           String
  /// The window held on the tee sheet: every tee time from holdFrom to holdTo (inclusive).
  holdFrom            String
  holdTo              String
  /// The course set holdTo by hand (kept when the event is edited).
  holdToCustom        Boolean             @default(false)
  /// Tee times only: which round's times are held (null = every round).
  productId           String?
  /// W2-9 (Cam 2026-10-22): false = the event closes the whole course in its
  /// window; true = it shares the course — only the nines in holdNineIds are
  /// held (empty = every nine) and the times in keepOpen stay bookable.
  shareCourse         Boolean             @default(false)
  holdNineIds         String[]            @default([])
  keepOpen            String[]            @default([])
  holes               Int                 @default(18)
  groups              Int                 @default(0)
  players             Int                 @default(0)
  organizerName       String              @default("")
  organizerEmail      String              @default("")
  organizerPhone      String              @default("")
  /// What each player pays the course (cents); 0 = not set yet.
  pricePerPlayerCents Int                 @default(0)
  /// What's included: cart, range, food, prizes … (the course's own words).
  includes            String[]
  /// The course's own deposit and refund terms for this event.
  terms               String              @default("")
  notes               String              @default("")
  /// planned | cancelled
  status              String              @default("planned")
  createdBy           String              @default("")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tasks               CourseEventTask[]
  entrants            CourseEventPlayer[]
  teeTimes            TeeTime[]
  payments            CourseEventPayment[]
  /// W2-9b: the headcount staff confirmed for the balance; null = not confirmed yet.
  finalHeadcount      Int?

  @@index([courseId, date])
}

/// W2-9: one item on an event's prep checklist.
model CourseEventTask {
  id        String      @id @default(cuid())
  eventId   String
  event     CourseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String
  /// YYYY-MM-DD; null = no due date.
  dueDate   String?
  doneAt    DateTime?
  doneBy    String      @default("")
  sortOrder Int         @default(0)

  @@index([eventId])
}

/// W2-9: a player in an event, with their group and starting hole (pairings).
model CourseEventPlayer {
  id        String      @id @default(cuid())
  eventId   String
  event     CourseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String      @default("")
  phone     String      @default("")
  /// 1-based group number; null = not in a group yet.
  groupNo   Int?
  /// Shotgun: the hole this group starts on. Tee times: null.
  startHole Int?
  payments  CourseEventPayment[]
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([eventId])
}

/// W2-9b (Cam 2026-10-22: "completely up to the courses on how to handle/charge
/// money"): one payment toward an event — taken at the course (recorded, no
/// charge) or by a pay link the organizer opens (a direct charge on the course's
/// Stripe account). Any amount, any number of them. lib/event-payments.ts.
///   link:   open ──▶ paying ──▶ paid        (declined → open)   open ──▶ void
///   course: paid on creation (cash, check, the course's own card machine)
model CourseEventPayment {
  id              String              @id @default(cuid())
  eventId         String
  event           CourseEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  courseId        String
  /// deposit | balance | other
  kind            String              @default("other")
  /// What it is for, in the course's words ("Deposit", "Balance for 72 players").
  label           String
  /// What the course receives.
  amountCents     Int
  /// GreenReserve's fee on top (paid by the payer). 0 while EVENT_FEE_ON is false.
  feeCents        Int                 @default(0)
  /// link | cash | check | card_counter | other
  method          String
  /// open | paying | paid | void
  status          String
  payToken        String              @default("")
  paymentIntentId String              @default("")
  chargeStartedAt DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  payerName       String              @default("")
  payerEmail      String              @default("")
  payerPhone      String              @default("")
  /// Balance: the headcount it was worked out from.
  headcount       Int?
  /// W2-9c: a player's own payment (their pay link, or paid at the course); null = the organizer's.
  playerId        String?
  player          CourseEventPlayer?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  note            String              @default("")
  /// Sum of refunds that went through or are in flight (reserved before Stripe is called).
  refundedCents   Int                 @default(0)
  createdBy       String              @default("")
  createdAt       DateTime            @default(now())
  refunds         CourseEventRefund[]

  @@index([eventId])
  @@index([courseId, status])
  @@index([playerId])
}

/// W2-9b: a refund of an event payment, made when the course decides to (its own terms).
/// pending → done | failed. A card refund's Stripe idempotency key is this row's id.
model CourseEventRefund {
  id             String             @id @default(cuid())
  paymentId      String
  payment        CourseEventPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         String             @default("pending")
  stripeRefundId String             @default("")
  reason         String             @default("")
  error          String             @default("")
  createdBy      String             @default("")
  createdAt      DateTime           @default(now())

  @@index([paymentId])
}
